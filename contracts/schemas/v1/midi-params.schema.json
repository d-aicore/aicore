{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicore.local/schemas/v1/midi-params.schema.json",
  "title": "S1b audio-to-MIDI parameters (profile midi, operation transcribe)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ppq": {
      "const": 960,
      "default": 960,
      "$comment": "Ruling S1b: 960 ticks/quarter, the resolution the Core DAW templates are recorded at. 480 was the S1 value and is now a contract violation (SCHEMA_INVALID)."
    },
    "quantize": {
      "enum": [
        "1/1",
        "1/2",
        "1/4",
        "1/8",
        "1/16",
        "1/32",
        "off"
      ],
      "default": "1/16",
      "$comment": "Ticks at PPQ 960: 1/1=3840, 1/2=1920, 1/4=960, 1/8=480, 1/16=240, 1/32=120; 'off' = 1 tick (no quantization, inherited from S1). 1/32 is the psytrance/hitech roll choice; 1/16 is the generic default."
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "drums",
          "bass",
          "other",
          "vocals"
        ]
      }
    },
    "kickNote": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "bassMono": {
      "type": "boolean"
    },
    "bpm": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 40,
          "maximum": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "bpmSource": {
      "enum": [
        "provided",
        "filename",
        "kick"
      ]
    },
    "leadFilter": {
      "type": "boolean"
    },
    "splitOnOnsets": {
      "type": "boolean"
    },
    "includeStems": {
      "type": "boolean"
    },
    "startSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 600
    },
    "lengthSeconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "$comment": "numpy/torch seeds are 32-bit; a larger seed used to pass the schema and fail later (audit 2026-11-16)"
    }
  },
  "required": [
    "ppq",
    "quantize",
    "parts",
    "kickNote",
    "bassMono"
  ]
}
