{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicore.local/schemas/v1/service-hello.schema.json",
  "title": "S1b service hello / capabilities (stdout line of `service_sim.py hello`)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "contract": {
      "const": "aicore.service/1"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "version",
        "pid"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "midi",
              "stems",
              "flamingo",
              "lora",
              "render"
            ]
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          }
        },
        "required": [
          "name",
          "operations"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxInputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 1
        },
        "maxDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxInputBytes",
        "maxOutputBytes",
        "maxDurationSeconds",
        "maxResponseBytes"
      ]
    },
    "ppq": {
      "const": 960,
      "$comment": "Ruling S1b: the hello is the one place the client can confirm the backend publishes PPQ 960 before submitting."
    },
    "quantizeGrid": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "1/1",
          "1/2",
          "1/4",
          "1/8",
          "1/16",
          "1/32",
          "off"
        ]
      }
    },
    "authRequired": {
      "const": false,
      "$comment": "No HTTP, no auth in this contract version (deferred with T1, CONTRACT.md \u00a713)."
    },
    "startedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "service",
    "profiles",
    "limits",
    "ppq",
    "quantizeGrid",
    "authRequired",
    "startedAt"
  ]
}
