{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicore.local/schemas/v1/error.schema.json",
  "title": "C00 error",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "requestId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object"
    }
  },
  "required": [
    "code",
    "message",
    "requestId",
    "retryable"
  ]
}
