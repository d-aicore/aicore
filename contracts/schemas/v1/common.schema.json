{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicore.local/schemas/v1/common.schema.json",
  "title": "C00 common definitions",
  "$defs": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "destination": {
      "type": "string",
      "pattern": "^(local|api):[A-Za-z0-9._/-]{1,128}$"
    },
    "purpose": {
      "enum": [
        "store",
        "retrieval",
        "memory_export",
        "curation",
        "training",
        "dataset_export",
        "adapter_export",
        "evaluation"
      ]
    },
    "originAssurance": {
      "enum": [
        "recorder_attested",
        "admin_entered",
        "model_proposed",
        "import_declared"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "projectId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "profileId",
        "projectId",
        "sessionId"
      ]
    },
    "eventRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producerId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "eventId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "producerId",
        "eventId"
      ]
    },
    "itemRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "itemId",
        "version"
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
