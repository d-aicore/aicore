{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicore.local/schemas/v1/task-manifest.schema.json",
  "title": "S1 runtime task manifest (written last, atomically, into outputDir)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "contract": {
      "const": "aicore.service/1"
    },
    "taskId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "profile": {
      "enum": [
        "midi",
        "stems",
        "flamingo",
        "lora",
        "render"
      ]
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "params": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "path": {
            "$ref": "media-format.schema.json#/$defs/absolutePath"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        },
        "required": [
          "role",
          "path",
          "bytes",
          "sha256"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "media-format.schema.json#/$defs/outputRef"
      }
    },
    "metrics": {
      "type": "object"
    },
    "environment": {
      "description": "Optional fingerprint of what produced the outputs (runtime, library versions, threads, seed, weight sha256), so 'same request -> same sha' is scoped to an environment.",
      "type": "object"
    },
    "validation": {
      "enum": [
        "unreviewed",
        "approved",
        "rejected"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "taskId",
    "requestId",
    "profile",
    "operation",
    "createdAt",
    "service",
    "params",
    "inputs",
    "outputs",
    "metrics",
    "validation",
    "synthetic"
  ]
}