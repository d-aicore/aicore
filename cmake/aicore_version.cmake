# Writes aicore_version.h: the AICORE version plus the git commit it was built
# from, so every build (and every report/log made with it) says exactly which
# code it is. Baked at CONFIGURE time (Core core_version.h pattern). The header
# only changes when the commit or the version changes.
#   cmake -DSOURCE=<repo> -DOUT=<file> -DVERSION=<x.y.z> -P aicore_version.cmake
set(hash "unknown")
set(date "")
set(dirty 0)
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} rev-parse --short=10 HEAD
                  OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0 AND out)
    set(hash "${out}")
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} log -1 --format=%cs
                    OUTPUT_VARIABLE date OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    # Uncommitted changes to tracked files: the build is not exactly that commit.
    # Untracked files (e.g. fresh evidence/logs) do not make the build dirty.
    execute_process(COMMAND ${GIT_EXECUTABLE} -C ${SOURCE} status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(changes)
      set(dirty 1)
    endif()
  endif()
endif()
if(hash STREQUAL "unknown" AND NOT ALLOW_UNKNOWN)
  # audit 2026-11-16: a build that cannot say which commit it is used to pass until the self-test.
  # It now stops here; -DAICORE_ALLOW_UNKNOWN_VERSION=ON is the explicit way out (e.g. a source zip).
  message(FATAL_ERROR "AICore-C: git commit unknown (no git, or not a git checkout). "
                      "Build from a clone, or pass -DAICORE_ALLOW_UNKNOWN_VERSION=ON on purpose.")
endif()
set(build "${VERSION}+${hash}")
if(dirty)
  set(build "${build}.modified")
endif()
set(text "// Generated by cmake/aicore_version.cmake at configure time. Do not edit.
#pragma once
#define AICORE_VERSION \"${VERSION}\"
#define AICORE_GIT_HASH \"${hash}\"
#define AICORE_GIT_DATE \"${date}\"
#define AICORE_GIT_MODIFIED ${dirty}
// What reports quote: version + commit (+ .modified when built with uncommitted changes).
#define AICORE_BUILD_ID \"${build}\"
")
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()